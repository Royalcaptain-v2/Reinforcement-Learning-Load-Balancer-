{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{.venv/**,__pycache__/**,.pytest_cache/**,docs/**,scripts/**,tests/**,public/**,*.log,*.pyc,*.pyo}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
